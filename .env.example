# Copy to .env.local for local work. Vite reads VITE_ variables at build time.

# Which backend the UI talks to: production, staging or demo (canned answers, no sign-in)
VITE_LUME_ENV=production

# Entra sign-in (production)
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_API_SCOPE=

# Staging only, for local work against the staging API. Never set this for a public build.
VITE_LUME_API_KEY=
